# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
#
# Không ignore: app, utils, requirements.txt — đó là thứ image CẦN.

# Secret — tuyệt đối không nướng vào image
.env
.env.*
!.env.example

# Git
.git
.gitignore
.github

# Python
__pycache__
**/__pycache__
*.py[cod]
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache
.ruff_cache

# Test và tài liệu — không cần trong image runtime
tests
screenshots
*.md
grade.py

# Docker / IDE / OS
Dockerfile
.dockerignore
docker-compose.yml
.vscode
.idea
.DS_Store
